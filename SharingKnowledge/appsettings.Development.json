{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "IdentityOptions": {
    "SignIn": {
      "RequireConfirmedEmail": false
    },
    "Lockout": {
      "MaxFailedAttempts": 100,
      "LockoutDuration": 1
    },
    "Password": {
      "RequireDigit": true,
      "RequireUppercase": false,
      "RequireLowercase": false,
      "RequireNonAlphanumeric": false,
      "RequireUniqueChars": 2
    }
  }
}
