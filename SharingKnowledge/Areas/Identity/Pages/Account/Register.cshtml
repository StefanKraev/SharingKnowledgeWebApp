@page
@model RegisterModel
@{
    ViewData["Title"] = "Create a New Account";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="text-center mb-4">
            <h1 class="fw-bold">@ViewData["Title"]</h1>
            <p class="text-muted">Join our community and start sharing knowledge</p>
            <hr class="w-25 mx-auto" />
        </div>

        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="px-3">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

            <div class="form-floating mb-3 shadow-sm">
                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                <label asp-for="Input.Email"><i class="bi bi-envelope-fill me-2"></i>Email Address</label>
                <span asp-validation-for="Input.Email" class="text-danger small"></span>
            </div>

            <div class="form-floating mb-3 shadow-sm">
                <input asp-for="Input.FacultyNumber" class="form-control" aria-required="true" placeholder="0MI0000000" />
                <label asp-for="Input.FacultyNumber"><i class="bi bi-card-text me-2"></i>Faculty Number</label>
                <span asp-validation-for="Input.FacultyNumber" class="text-danger small"></span>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-floating mb-3 shadow-sm">
                        <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" />
                        <label asp-for="Input.Password">Password</label>
                        <span asp-validation-for="Input.Password" class="text-danger small"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-floating mb-3 shadow-sm">
                        <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" />
                        <label asp-for="Input.ConfirmPassword">Confirm Password</label>
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <button id="registerSubmit" type="submit" class="w-100 btn btn-lg btn-primary shadow-sm mt-3 py-3 fw-bold uppercase">
                Create Account
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}