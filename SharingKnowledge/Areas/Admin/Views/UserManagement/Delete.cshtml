@using Microsoft.AspNetCore.Identity
@model IdentityUser

@{
    ViewData["Title"] = "Delete User";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-danger shadow">
                <div class="card-header bg-danger text-white text-center">
                    <h3 class="mb-0"><i class="bi bi-exclamation-triangle-fill"></i> Delete User?</h3>
                </div>
                <div class="card-body text-center">
                    <p class="lead">Are you sure you want to permanently delete this user?</p>

                    <div class="alert alert-light border">
                        <strong>Username:</strong> @Model.UserName <br />
                        <strong>Email:</strong> @Model.Email <br />
                        <strong>User ID:</strong> <small class="text-muted">@Model.Id</small>
                    </div>

                    <p class="text-danger small">
                        <i class="bi bi-info-circle"></i> This action cannot be undone. All associated data for this user will be removed.
                    </p>

                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="Id" />

                        <div class="d-grid gap-2 d-md-block">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4">
                                <i class="bi bi-x-circle"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-danger px-4">
                                <i class="bi bi-trash"></i> Confirm Delete
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>