@using System.Security.Claims
@model IEnumerable<SharingKnowledge.Areas.Admin.ViewModels.UserViewModel>

@{
    ViewData["Title"] = "User Management";
    var currentUserId = User.FindFirstValue(System.Security.Claims.ClaimTypes.NameIdentifier);
}

<h1 class="mb-4">User Management</h1>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">No users found.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Email</th>
                    <th>Roles</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>@user.Email</td>
                        <td>
                            @if (user.Roles.Any())
                            {
                                @foreach (var role in user.Roles)
                                {
                                    <span class="badge bg-primary">@role</span>
                                }
                            }
                            else
                            {
                                <span class="text-muted">No roles assigned</span>
                            }
                        </td>
                        <td>
                            @if (currentUserId != user.Id)
                            {
                                <select id="roleDropdown-@user.Id" class="form-select form-select-sm w-auto me-2">
                                    <option value="Manager" selected="@(user.Roles.Contains("Manager") ? "selected" : null)">Manager</option>
                                    <option value="User" selected="@(user.Roles.Contains("Student") ? "selected" : null)">Student</option>
                                </select>
                                <form method="post" asp-action="AssignRole" asp-controller="UserManagement" asp-area="Admin" class="d-inline">
                                    <input type="hidden" name="userId" value="@user.Id" />
                                    <input type="hidden" name="role" id="assignRoleInput-@user.Id" />
                                    <button type="submit" class="btn btn-primary btn-sm fw-bold px-3 py-2"
                                            onclick="setRoleValue('@user.Id', 'assignRoleInput')">
                                        <i class="bi bi-person-plus-fill"></i> Assign
                                    </button>
                                </form>
                                <a asp-area="Admin" asp-controller="UserManagement" asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-warning" title="Edit">
                                    <i class="bi bi-pencil-square"></i> Edit
                                </a>
                                <a asp-area="Admin" asp-controller="UserManagement" asp-action="Delete" asp-route-id="@user.Id" class="btn btn-sm btn-danger" title="Delete">
                                    <i class="bi bi-trash"></i> Delete
                                </a>
                            }
                            else
                            {
                                <span class="text-muted"><i class="bi bi-shield-check"></i> Admin (Current User)</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
