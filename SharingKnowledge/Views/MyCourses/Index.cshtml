@model ICollection<SharingKnowledge.Web.ViewModels.Courses.OpenCoursesMyCoursesViewModel>

@{
    ViewData["Title"] = "My Courses";
}

<h1 class="mb-4">My Courses</h1>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">You are not enrolled in any courses yet.</div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var course in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    @if (!string.IsNullOrWhiteSpace(course.ImageUrl))
                    {
                        <img src="@course.ImageUrl" class="card-img-top" alt="@course.Title" style="object-fit:contain; height:180px;background-color: #f8f9fa;" />
                    }
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@course.Title</h5>
                        <p class="card-text text-muted mb-2">
                            <small>
                                <span class="me-2"><strong>Starts:</strong> @course.StartDate.ToString("MMMM d, yyyy")</span>
                                <span class="badge bg-secondary">@course.CategoryName</span>
                            </small>
                        </p>
                        <p class="card-text">@course.Description</p>
                        <div class="mt-auto">
                            <div class="d-flex gap-2">
                                <a asp-action="Details" asp-route-id="@course.Id" class="btn btn-primary flex-fill">
                                    View Details
                                </a>

                                <form asp-action="Unenroll" asp-route-courseId="@course.Id" method="post" class="flex-fill">
                                    <button type="submit" class="btn btn-outline-danger w-100"
                                            onclick="return confirm('Are you sure you want to leave this course?');">
                                        <i class="bi bi-x-circle"></i> Leave
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
