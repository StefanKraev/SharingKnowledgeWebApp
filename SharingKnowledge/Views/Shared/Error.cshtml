@model ErrorViewModel
@{
    Context.Response.StatusCode = 500;
    ViewData["Title"] = "Server Error";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-9">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-start gap-3">
                        <div class="display-1 text-danger mb-0">500</div>
                        <div>
                            <h1 class="h3 mb-1">Something went wrong</h1>
                            <p class="text-muted mb-3">
                                An unexpected error occurred while processing your request.
                                Our team has been notified (if you see this repeatedly, please contact support).
                            </p>

                            <div class="mb-3">
                                <a asp-controller="Home" asp-action="Index" class="btn btn-primary me-2">Return to Home</a>
                                <a asp-controller="Home" asp-action="Privacy" class="btn btn-outline-secondary">Privacy policy</a>
                            </div>

                            <hr />

                            <h6 class="mb-2">Error details</h6>
                            <p class="text-muted small mb-2">
                                If you need help troubleshooting, provide the request id below when contacting support.
                            </p>

                            @if (!string.IsNullOrEmpty(Model?.RequestId))
                            {
                                <div class="bg-light p-2 rounded">
                                    <strong>Request id:</strong>
                                    <code class="ms-2">@Model.RequestId</code>
                                </div>
                            }
                            else
                            {
                                <div class="text-muted small">Request id not available.</div>
                            }

                            <div class="mt-3 text-muted small">
                                <p>
                                    For security reasons we do not display internal error details here. Check server logs for full diagnostics.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer text-muted small">
                    &copy; 2026 - SharingKnowledge
                </div>
            </div>
        </div>
    </div>
</div>


