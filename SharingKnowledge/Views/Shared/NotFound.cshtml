@{
    Context.Response.StatusCode = 404;
    ViewData["Title"] = "Page Not Found";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 text-center">
            <div class="display-1 text-muted fw-bold">404</div>
            <h1 class="mb-3">We can't find that page</h1>
            <p class="lead text-muted mb-4">
                The page you're looking for might have been removed, had its name changed, or is temporarily unavailable.
            </p>

            <div class="mb-4">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary me-2">Go to Home</a>
                <a asp-controller="OpenCourses" asp-action="Index" class="btn btn-outline-secondary">Browse Courses</a>
            </div>

            <p class="text-muted small">
                If you believe this is an error, please contact support at
                <a href="mailto:support@sharingknowledge.com">support@sharingknowledge.com</a>.
            </p>

            <hr />

            <div class="text-start mt-4">
                <strong>Tips:</strong>
                <ul>
                    <li>Check the URL for typos.</li>
                    <li>Use the navigation menu to find what you need.</li>
                </ul>
            </div>
        </div>
    </div>
</div>