@model IEnumerable<SharingKnowledge.Web.ViewModels.Books.AllBooksViewModel>

@{
    ViewData["Title"] = "Library";
}

<h1 class="mb-4">Library</h1>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">No books available.</div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var book in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    @if (!string.IsNullOrWhiteSpace(book.ImageUrl))
                    {
                        <img src="@book.ImageUrl" class="card-img-top" alt="@book.Title" style="object-fit:cover; height:220px;" />
                    }
                    else
                    {
                        <div class="bg-light d-flex align-items-center justify-content-center" style="height:220px;">
                            <span class="text-muted">No image</span>
                        </div>
                    }

                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title mb-1">@book.Title</h5>
                        <p class="mb-1 text-muted"><small>by @book.AuthorName</small></p>
                        <p class="mb-2"><span class="badge bg-secondary">@book.CategoryName</span></p>

                        <div class="mt-auto d-flex gap-2">
                            <a asp-controller="Library" asp-action="Details" asp-route-id="@book.Id" class="btn btn-sm btn-primary">Details</a>

                            @if (book.IsInUserLibrary)
                            {
                                <span class="btn btn-sm btn-outline-success disabled">In my library</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
