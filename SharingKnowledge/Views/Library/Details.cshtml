@using System.Security.Claims
@model SharingKnowledge.Web.ViewModels.Books.DetailsBookViewModel

@{
    ViewData["Title"] = Model?.Title ?? "Book details";
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
}

<div class="container py-4">
    <a asp-controller="Library" asp-action="Index" class="btn btn-link mb-3">&larr; Back to library</a>

    <div class="card mb-4 shadow-sm">
        @if (!string.IsNullOrWhiteSpace(Model?.ImageUrl))
        {
            <img src="@Model.ImageUrl" class="card-img-top" alt="@Model.Title" style="object-fit:cover; height:320px;" />
        }
        <div class="card-body">
            <h1 class="card-title">@Model.Title</h1>
            <p class="text-muted mb-2">
                <small>
                    <span class="me-3"><strong>Author:</strong> @Model.AuthorName</span>
                    <span class="badge bg-secondary">@Model.CategoryName</span>
                </small>
            </p>

            <hr />

            <div class="mb-3">
                <p class="card-text">@Model.Description</p>
            </div>

            <div class="d-flex gap-2">
                <a asp-controller="Library" asp-action="Index" class="btn btn-outline-secondary">Back</a>
                @if (Model != null && Model.PublisherId == currentUserId)
                {
                    <a asp-controller="Library" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
                    <a asp-controller="Library" asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Delete</a>
                }
            </div>
        </div>
    </div>
</div>
