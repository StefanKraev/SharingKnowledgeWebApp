﻿@using System.Globalization
@model SharingKnowledge.ViewModels.Courses.OpenCoursesDetailsViewModel

@{
    ViewData["Title"] = Model?.Title ?? "Course details";
}

<div class="container py-4">
    <a asp-controller="OpenCourses" asp-action="Index" class="btn btn-link mb-3">&larr; Back to courses</a>

    <div class="card mb-4 shadow-sm">
        @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl"
                 class="card-img-top bg-light"
                 alt="@Model.Title"
                 style="object-fit: contain; height: 320px; width: 100%;" />
        }

        <div class="card-body">
            <h1 class="card-title">@Model.Title</h1>

            <p class="text-muted mb-2">
                <small>
                    <span class="me-3"><strong>Starts:</strong> @Model.StartDate.ToString("MMMM d, yyyy", CultureInfo.InvariantCulture)</span>
                    <span class="badge bg-secondary">@Model.CategoryName</span>
                </small>
            </p>

            <hr />

            <div class="mb-3">
                <p class="card-text">@Model.Description</p>
            </div>

            <div class="alert alert-light border-0 p-0 mb-4">
                <p class="mb-0">
                    <strong>
                        Instructor:
                        @if (!string.IsNullOrEmpty(Model.AuthorEmail))
                        {
                            <span>@Model.AuthorEmail</span>
                        }
                        else
                        {
                            <span class="text-danger">Email not found</span>
                        }
                    </strong>
                </p>
            </div>

            <div class="d-flex gap-2">
                <a asp-controller="OpenCourses" asp-action="Index" class="btn btn-outline-secondary">Back</a>
            </div>
        </div>
    </div>
</div>